{
  "name": "phoneme-synthesizer",
  "private": true,
  "scripts": {
    "build": "swift build -c release",
    "test": "swift test",
    "synth": "swift run -c release phoneme-synth synth",
    "benchmark": "bun scripts/update-benchmark.ts commit",
    "benchmark:full": "bun scripts/update-benchmark.ts full",
    "hooks:install": "git config core.hooksPath .githooks",
    "test:ts": "bun test scripts/*.test.ts",
    "site:build": "bun scripts/build-site.ts && vite build --config site/vite.config.ts",
    "site:dev": "bun scripts/build-site.ts && vite --config site/vite.config.ts",
    "ci": "bun test && swift test && swift build -c release && bun scripts/validate-benchmark.ts && bun run site:build",
    "benchmark:validate": "bun scripts/validate-benchmark.ts"
  },
  "dependencies": {
    "marked": "^18.0.11",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "yaml": "^2.8.1"
  },
  "packageManager": "bun@1.4.0",
  "devDependencies": {
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
